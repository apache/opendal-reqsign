      "name": "reqsign-aws-core",
      "role": "Shared AWS credential chain and canonicalization used by both SigV4 and SigV4a."
    },
    {
      "name": "reqsign-file-read-tokio",
      "role": "Context component: file reading backed by Tokio."
    },
    {
      "name": "reqsign-http-send-reqwest",
      "role": "Context component: HTTP sending backed by reqwest."
    },
    {
      "name": "reqsign-command-execute-tokio",
      "role": "Context component: command execution backed by Tokio."
    },
    {
      "name": "reqsign",
      "role": "Facade crate re-exporting every service behind feature flags, with default_context() and per-service default signers."
